{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequake.dev/schemas/eq-mcp-1.0/eq_search.input.json",
  "title": "eq_search input",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "string",
      "enum": ["naive", "local", "global", "hybrid", "mix"],
      "default": "mix",
      "description": "naive=dense chunks; local=entity neighborhood; global=themes; hybrid=local∪global; mix=fused+rerank (default)"
    },
    "scope": {
      "type": "string",
      "enum": ["workspace", "documents"],
      "default": "workspace"
    },
    "document_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Primary scope. XOR with document_pattern."
    },
    "document_pattern": {
      "type": "string",
      "description": "Filename glob; prefer document_ids when known"
    },
    "budget": {
      "enum": ["cheap", "standard", "deep"],
      "default": "standard"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 8,
      "description": "Max hits (not sessions)"
    },
    "cursor": { "type": "string" },
    "workspace_id": {
      "type": "string",
      "x-mcp-header": "Workspace-Id"
    }
  }
}
