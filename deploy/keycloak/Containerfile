# EdgeQuake-flavoured Keycloak (SPEC-158 W4) — optimized build, realm baked in.
#
#   docker build -f deploy/keycloak/Containerfile -t edgequake-keycloak deploy/keycloak
#
# Run (prod):  start --optimized --import-realm   (needs KC_DB_*, KC_HOSTNAME, bootstrap admin)
# Run (dev):   start-dev --import-realm           (see docker-compose.keycloak.yml)
#
# Pin >= 26.8.0: fixes CVE-2026-4633 (organization enumeration). Pin the digest in production.
ARG KEYCLOAK_VERSION=26.8.0

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION} AS builder
# Build-time options (cannot change at runtime with --optimized).
ENV KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_DB=postgres
WORKDIR /opt/keycloak
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION}
COPY --from=builder /opt/keycloak/ /opt/keycloak/
# Realm import is create-only: an existing realm is skipped on restart (see docs).
COPY realm/ /opt/keycloak/data/import/

ENV KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_DB=postgres

# Management interface (health + metrics) listens on 9000, application on 8080/8443.
EXPOSE 8080 8443 9000
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
