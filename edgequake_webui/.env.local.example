# EdgeQuake WebUI Environment Configuration
# Copy this file to .env.local and update the values

# API Configuration
# Production/docker: absolute URL injected via EDGEQUAKE_API_URL at container start.
# Local dev: leave NEXT_PUBLIC_API_URL unset — Next.js rewrites proxy /api/v1.
# Ports are auto-written to .env.local.ports by `make sync-dev-ports` (8090/3010 range).
# Manual override only when not using make dev:
# EDGEQUAKE_API_URL=http://127.0.0.1:8090

# Optional: Default tenant ID for multi-tenant deployments
# NEXT_PUBLIC_DEFAULT_TENANT_ID=default

# Optional: Feature flags
# NEXT_PUBLIC_ENABLE_DEMO_MODE=true
# NEXT_PUBLIC_ENABLE_API_EXPLORER=true

# SPEC-157: set to 0 to disable the Query companion pane (citations navigate to /documents again)
# NEXT_PUBLIC_QUERY_COMPANION=1
